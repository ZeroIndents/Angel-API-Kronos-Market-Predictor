# ==========================================================================
# Kronos TV — Chart Viewer credentials
# Copy this file to `.env` (same folder or project root) and fill it in.
# The chart-viewer server reads it on startup and seeds smartapi_config.json
# so the whole platform (Live AI, Simulation, dashboard) picks it up too.
# ==========================================================================

# Angel One SmartAPI credentials — free account at
# https://smartapi.angelbroking.com -> "My Profile" -> "API" tab
# (create an app there to obtain the API key).
API_KEY=your_api_key

# Angel One client code (your trading account user ID, e.g. S1234567)
CLIENT_ID=your_client_id

# Angel One trading PIN (4 digits)
PIN=your_4_digit_pin

# OPTIONAL but recommended: the base32 TOTP secret from the Angel One
# authentication app ("Angel One SmartAPI TOTP" in Google Authenticator).
# With it, the server can generate the 2FA code automatically and log in
# without typing a code every day. To extract the secret on Android, scan
# the QR with an app like "OTP Auth" or use a rooted/backup export; on iOS
# use the "Angel One" in-app secret export if available.
TOTP_SECRET=

# Port and host for the chart viewer web app (exposing to all interfaces on port 81)
TV_PORT=81
TV_HOST=0.0.0.0
